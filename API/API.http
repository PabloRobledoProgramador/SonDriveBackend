@API_HostAddress = http://localhost:5064

# 1. Iniciar sesión y copiar el "token" de la respuesta en @token
POST {{API_HostAddress}}/api/autenticacion/iniciar-sesion
Content-Type: application/json

{
  "correo": "admin@sondrive.com",
  "clave": "Admin12345*"
}

###

# 1b. Datos inválidos: 400 ValidationProblemDetails con errores por campo (Correo, Clave)
POST {{API_HostAddress}}/api/autenticacion/iniciar-sesion
Content-Type: application/json

{
  "correo": "no-es-un-correo",
  "clave": ""
}

###

# 1c. Clave errada: 401 ProblemDetails con "Correo o clave incorrectos."
POST {{API_HostAddress}}/api/autenticacion/iniciar-sesion
Content-Type: application/json

{
  "correo": "admin@sondrive.com",
  "clave": "clave-errada"
}

###

# 1d. Recurso protegido sin token: 401 con cuerpo ProblemDetails (application/problem+json)
GET {{API_HostAddress}}/api/autenticacion/perfil

###

@token = pegar-aqui-el-token

# 2. Datos del usuario autenticado
GET {{API_HostAddress}}/api/autenticacion/perfil
Authorization: Bearer {{token}}

###

# 3. Endpoint solo para administradores
GET {{API_HostAddress}}/api/usuario
Authorization: Bearer {{token}}

###

# 4. Editar datos de un conductor (solo administradores). Cambia nombre, apellido, correo, celular
#    y foto; no toca estado, rol ni clave. Usa el id de un conductor de la lista anterior.
PUT {{API_HostAddress}}/api/usuario/2/conductor
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Carlos",
  "apellido": "Gómez",
  "correo": "carlos@sondrive.com",
  "celular": "3001234567",
  "foto": null
}

###

# 4b. Datos inválidos: 400 ValidationProblemDetails con errores por campo (Nombre, Celular, Foto)
PUT {{API_HostAddress}}/api/usuario/2/conductor
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "",
  "apellido": "Gómez",
  "correo": "carlos@sondrive.com",
  "celular": "123",
  "foto": "abc"
}

###

# 5. Crear usuario (solo administradores) con una foto que no es una dirección web:
#    400 con errores.Foto. La foto es opcional; si se envía debe ser http o https (máx. 500).
POST {{API_HostAddress}}/api/usuario
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Ana",
  "apellido": "Torres",
  "correo": "ana@sondrive.com",
  "clave": "Conductor123*",
  "celular": "3012345678",
  "estado": true,
  "rol": "Conductor",
  "foto": "abc"
}

###

# 6. Editar datos de un vehículo (solo administradores). Se envían siempre los diez datos.
#    200 con el vehículo actualizado: placa en mayúsculas y sin espacios, estado y días
#    restantes recalculados. Con el token de un conductor responde 403, también sobre su
#    propio vehículo. Si idUsuario cambia, el vehículo y sus viajes próximos pasan a ese conductor.
PUT {{API_HostAddress}}/api/vehiculo/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "idUsuario": 2,
  "placa": "abc 123",
  "modelo": "Kia Rio",
  "annoModelo": "2022",
  "tipo": "Sedan",
  "kilometraje": 49500,
  "fechaUltimoServicio": "2026-09-20",
  "vencimientoSoat": "2027-10-11",
  "vencimientoTecnomecanica": "2027-06-30",
  "vencimientoLicencia": "2029-03-05"
}

###

# 6b. Datos inválidos: 400 ValidationProblemDetails con errores por campo (Placa, Modelo, Kilometraje)
PUT {{API_HostAddress}}/api/vehiculo/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "idUsuario": 2,
  "placa": "AB12",
  "modelo": "",
  "annoModelo": "2022",
  "tipo": "Sedan",
  "kilometraje": -5,
  "fechaUltimoServicio": null,
  "vencimientoSoat": "2027-10-11",
  "vencimientoTecnomecanica": "2027-06-30",
  "vencimientoLicencia": "2029-03-05"
}

###
