# Copia este archivo como .env (no se sube al repositorio) y ajusta los valores.
# Cada desarrollador tiene su propio servidor: estos valores son solo de tu equipo.

# Clave del usuario "sa" del SQL Server del contenedor. Requisitos de SQL Server: mínimo
# 8 caracteres con mayúsculas, minúsculas, números y símbolos. No uses ";" (rompe la cadena
# de conexión). La clave queda fijada al crear la base en db/: si la cambias después, vuelve a
# poner la anterior o borra la carpeta db/ (se pierden los datos) con los contenedores detenidos.
SQL_CLAVE_SA=Cambia-Esta-Clave-2026

# Puertos publicados en tu equipo (cámbialos si ya están ocupados)
SQL_PUERTO=14330
API_PUERTO=5064
FRONTEND_PUERTO=5173

# Opcional: usar tu propio SQL Server instalado en lugar del contenedor. Desde Docker, tu equipo
# se llama host.docker.internal y la autenticación de Windows no funciona (usa usuario y clave).
# CADENA_CONEXION=Server=host.docker.internal,1433;Database=SonDriveDB;User Id=sondrive;Password=tu-clave;TrustServerCertificate=True

# Opcional: ubicación del repositorio del frontend si no está junto a este
# RUTA_FRONTEND=../SonDriveFrontend
